{
  "name": "bangkok-plot-envelope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:perf": "PERF_TESTS=1 vitest run --no-file-parallelism src/core/evaluate.perf.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-19",
    "earcut": "^3.2.4",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terra-draw": "^1.40.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/earcut": "^3.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
